#!/bin/bash
#
# Runs after the package payload has been installed. Launch the app in the
# console user's session so the onboarding window can explain the one permission
# it needs; a package script runs as root and has no GUI session of its own.
#
set -euo pipefail

APP="/Applications/No Drag Release Delay.app"
CONSOLE_USER="$(stat -f '%Su' /dev/console)"

if [ -d "$APP" ] && [ -n "$CONSOLE_USER" ] && [ "$CONSOLE_USER" != "root" ]; then
    # A self-update installs over a running instance: retire the old process
    # before handing the fresh bundle the user's session.
    pkill -x NoDragReleaseDelay 2>/dev/null || true
    sleep 0.3
    launchctl asuser "$(id -u "$CONSOLE_USER")" open "$APP" || true
fi

exit 0
